{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(npm run*)",
            "command": "python3 \"H:/HYPERFOCUSZONE/HperCore/WelshDog-Mission-Control/scripts/mc_env_guard.py\"; exit 0",
            "shell": "powershell",
            "timeout": 15,
            "statusMessage": "Checking MC env vars..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$j = $input | ConvertFrom-Json; $f = $j.tool_input.file_path; if ($f -match 'render\\.yaml|vercel\\.json') { python3 \"H:/HYPERFOCUSZONE/HperCore/WelshDog-Mission-Control/scripts/mc_config_validator.py\" $f }",
            "shell": "powershell",
            "timeout": 30,
            "statusMessage": "Validating MC config file..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"H:/HYPERFOCUSZONE/HperCore/WelshDog-Mission-Control/scripts/mc_session_start.py\"",
            "shell": "powershell",
            "timeout": 30,
            "statusMessage": "HyperFocus Z0ne MC session start..."
          },
          {
            "type": "command",
            "command": "python3 \"H:/HYPERFOCUSZONE/HperCore/WelshDog-Mission-Control/scripts/mc_broski_xp_reward.py\" --reason session_start",
            "shell": "powershell",
            "timeout": 30,
            "statusMessage": "Awarding BROski$ XP..."
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"H:/HYPERFOCUSZONE/HperCore/WelshDog-Mission-Control/scripts/mc_session_end.py\"",
            "shell": "powershell",
            "timeout": 30,
            "statusMessage": "HyperFocus Z0ne MC session end..."
          },
          {
            "type": "command",
            "command": "python3 \"H:/HYPERFOCUSZONE/HperCore/WelshDog-Mission-Control/scripts/mc_broski_xp_reward.py\"",
            "shell": "powershell",
            "timeout": 30,
            "statusMessage": "Awarding BROski$ XP..."
          }
        ]
      }
    ]
  }
}
