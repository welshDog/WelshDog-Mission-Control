# 🧠 Mission Control — Environment Variables
# Copy this to .env.local and fill in your actual values.
# NEVER commit .env.local — secrets stay out of git (Sacred Rule).

# ⚙️ SUPABASE — the Vibe Coding Course project
#   (yhtmuibgdnxhbgboajhc.supabase.co — same one Hyper-Vibe-Coding-Course uses).
#   MC reads/writes mc_missions on this project; admin login goes through
#   Supabase Auth on this project.
VITE_SUPABASE_URL=https://yhtmuibgdnxhbgboajhc.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# 🌐 APP CONFIG
VITE_APP_NAME=Mission Control
VITE_APP_ENV=development          # or production
VITE_APP_URL=http://localhost:5174

# 🛰️ REAL-TIME (Socket.io — for external events outside Supabase Realtime)
#   Wires up in a later commit. Reserved env so it doesn't break later.
VITE_SOCKET_URL=http://localhost:3010
SOCKET_PORT=3010

# 🔐 ADMIN ALLOWLIST — comma-separated emails authorised for Mission Control.
#   Fail-closed: empty allowlist = nobody gets in.
#   Defence in depth: also enforce via RLS on mc_missions (next hardening commit).
VITE_ADMIN_ALLOWLIST=lyndzwills@gmail.com

# ─────────────────────────────────────────────────────────────────────
# 🛰️ MC OPS API (server/index.js — Express)
#   Routes: /api/send-dm (Catch Stragglers DM delivery)
#   Vite dev proxies /api/* → http://localhost:$API_PORT
# ─────────────────────────────────────────────────────────────────────
API_PORT=3011
API_CORS_ORIGINS=http://localhost:5174

# 🤖 DISCORD BOT — required for /api/send-dm.
#   Bot must be in a server with the recipient + have privileged intents
#   enabled (Message Content + Direct Messages). NEVER commit this value.
DISCORD_BOT_TOKEN=

# 🔑 SUPABASE SERVICE ROLE — server-only, bypasses RLS for mc_missions
#   audit inserts + per-user rate-limit lookups. NEVER expose to the
#   browser (no VITE_ prefix on purpose). Different key from VITE_SUPABASE_ANON_KEY.
SUPABASE_URL=https://yhtmuibgdnxhbgboajhc.supabase.co
SUPABASE_SERVICE_KEY=
