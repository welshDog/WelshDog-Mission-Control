# 🧠 Mission Control — Environment Variables
# Copy this to .env.local and fill in your actual values.
# NEVER commit .env.local — secrets stay out of git (Sacred Rule).

# ⚙️ SUPABASE — the Vibe Coding Course project
#   (tlavrxiaegbtyfmjfdcz.supabase.co — same one Hyper-Vibe-Coding-Course uses).
#   MC reads/writes mc_missions on this project; admin login goes through
#   Supabase Auth on this project.
VITE_SUPABASE_URL=https://tlavrxiaegbtyfmjfdcz.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# 🌐 APP CONFIG
VITE_APP_NAME=Mission Control
VITE_APP_ENV=development          # or production
VITE_APP_URL=http://localhost:5174

# 🛰️ REAL-TIME (Socket.io — for external events outside Supabase Realtime)
#   Wires up in a later commit. Reserved env so it doesn't break later.
VITE_SOCKET_URL=http://localhost:3010
SOCKET_PORT=3010

# 🔐 ADMIN ALLOWLIST — comma-separated emails authorised for Mission Control.
#   Fail-closed: empty allowlist = nobody gets in.
#   Defence in depth: also enforce via RLS on mc_missions (next hardening commit).
VITE_ADMIN_ALLOWLIST=lyndzwills@gmail.com

# ─────────────────────────────────────────────────────────────────────
# 🛰️ MC OPS API (server/index.js — Express)
#   Routes: /api/send-dm (Catch Stragglers DM delivery)
#   Vite dev proxies /api/* → http://localhost:$API_PORT
# ─────────────────────────────────────────────────────────────────────
API_PORT=3011
API_CORS_ORIGINS=http://localhost:5174

# 🤖 DISCORD BOT — required for /api/send-dm.
#   Bot must be in a server with the recipient + have privileged intents
#   enabled (Message Content + Direct Messages). NEVER commit this value.
#   Server also accepts DISCORD_TOKEN as a fallback alias (matches the
#   broski Discord bot's env convention) — set either, not both.
DISCORD_BOT_TOKEN=

# 🔑 SUPABASE SERVICE ROLE — server-only, bypasses RLS for mc_missions
#   audit inserts + per-user rate-limit lookups. NEVER expose to the
#   browser (no VITE_ prefix on purpose). Different key from VITE_SUPABASE_ANON_KEY.
#   Name matches the Supabase dashboard / SDK convention exactly.
SUPABASE_URL=https://tlavrxiaegbtyfmjfdcz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# 💰 GRANT TOKENS — per-call hard cap (catches finger-trouble).
#   Optional; defaults to 10000 BROski$ per single grant call.
#   Daily-aggregate caps land later once we have audit-data shape.
MAX_GRANT_PER_CALL=10000

# 💸 STRIPE — required for /api/refund. Server-only; never expose.
#   In dev use sk_test_..., in prod sk_live_... — same env name.
#   Same secret the course's stripe-webhook edge function uses.
#   Without this set, /api/refund returns 500 stripe_not_configured.
STRIPE_SECRET_KEY=

# 🧭 BROSKI NEXT-BEST-MOVE — optional. Server-only; never prefix with VITE_.
#   Enables the COO brief inside /api/broski/next-move. Without a key the
#   panel still works (rule-based suggestions only). broski-coo runs under
#   `--profile agents` in HyperCode-V2.4, default port 8025.
BROSKI_COO_URL=http://localhost:8025
BROSKI_COO_KEY=

# Refund rate limits per admin (optional; defaults shown)
# REFUND_PREVIEW_MAX_PER_MIN=30
# REFUND_MAX_PER_10MIN=5
# GRANT_PREVIEW_MAX_PER_MIN=30
# GRANT_MAX_PER_10MIN=10
# SEND_DM_MAX_PER_10MIN=40

# Bearer token required by GET /metrics. Unset: open in dev, 503 in production.
# METRICS_TOKEN=
