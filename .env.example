# 🐶 WelshDog Mission Control — Environment Variables
# Copy this to .env.local and fill in your actual values.
# NEVER commit .env.local — secrets stay out of git (Sacred Rule).

# ⚙️ SUPABASE — same project as welshdog-designs-web3-shop
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# 🌐 APP CONFIG
VITE_APP_NAME=WelshDog Mission Control
VITE_APP_ENV=development           # or production
VITE_APP_URL=http://localhost:5173

# 🛰️ REAL-TIME (Socket.io — for external events outside Supabase Realtime)
VITE_SOCKET_URL=http://localhost:3010
SOCKET_PORT=3010

# 🔐 ADMIN GATE — Supabase Auth handles login + TOTP MFA natively.
# Add allow-listed admin emails (comma-separated) for the verification layer.
VITE_ADMIN_ALLOWLIST=
